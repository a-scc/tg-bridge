# tg-bridge poller (systemd unit 模板)
#
# 本文件是**模板**: __RUN_USER__ / __RUN_HOME__ / __INSTALL_DIR__ / __PYTHON__ /
# __TG_OWNER_ID__ 由 install.sh 注入。手工安装请先把这 5 个占位符换成实际值,
# 否则服务起不来(install.sh 会拒绝安装带占位符的 unit)。
#
# 要点:
#   - EnvironmentFile 前缀 '-' 表示文件缺省也不报错(proxy.env 是沙箱出口代理配置, 没有就留空)
#   - TG_OWNER_ID 必填。poller.py 不再内置默认值: 缺失或非数字会直接退出, 不会退回到任何人的 id
#   - RestartPreventExitStatus=2: 单例冲突/401/409 时不重启(重启也是白抢同一个 offset)

[Unit]
Description=tg-bridge connector poller
After=network.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__PYTHON__ __INSTALL_DIR__/poller.py
Environment=HOME=__RUN_HOME__
# 出口代理会切断超过 ~20-30s 的 TLS 连接, 所以长轮询压到 20 (仓库默认 50)
Environment=TG_LONGPOLL_TIMEOUT=20
# 只影响 batch_id 命名; checker 已 hardcode BATCH_WINDOW=0、无等待, 立即投递
Environment=TG_BATCH_GROUP_SECS=150
Environment=TG_BATCH_GROUP_MAX=10
# 注意: TG_DEFER_WHILE_BUSY_SECS 由 tg_bridge_check.sh 读取, 而 checker 是 Hatch hook
# 拉起的进程, 不是本服务的子进程 —— 写在这里读不到。要设就写在 hook 的命令行上:
#   TG_DEFER_WHILE_BUSY_SECS=120 bash <install_dir>/tg_bridge_check.sh
Environment=TG_OWNER_ID=__TG_OWNER_ID__
EnvironmentFile=-__INSTALL_DIR__/systemd/proxy.env
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
